# ========================================================
# Nexa Mint Studio — Root .gitignore
# ========================================================

# --------------------------------------------------------
# Environment & Secret Files (CRITICAL)
# --------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
# Explicitly allow example environment templates
!.env.example
!**/.env.example

# Private keys, certificates, JWTs, and credential stores
*.pem
*.key
*.pkcs12
*.pfx
*.jwt
*secret*
!*secret*.md
credentials.json
secrets.json
service-account*.json

# --------------------------------------------------------
# Dependencies (at all levels)
# --------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/

# --------------------------------------------------------
# Build & Distribution Outputs
# --------------------------------------------------------
frontend/dist/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
bundle/
build/

# --------------------------------------------------------
# Hardhat Build Artifacts & Cache
# --------------------------------------------------------
contracts-project/artifacts/
contracts-project/cache/
artifacts/
**/artifacts/
cache/
**/cache/
typechain/
typechain-types/
coverage/
**/coverage/
coverage.json
.gas-snapshot/
snapshots/

# --------------------------------------------------------
# Local Backups & Archive Files
# --------------------------------------------------------
frontend-backup/
nexa-mint-studio.zip
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*.tmp
*.temp

# --------------------------------------------------------
# Logs & Process Output
# --------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------
# OS & Editor Files
# --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
