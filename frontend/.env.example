# Nexa Mint Studio - Frontend Environment Configuration
# Copy this file to .env before starting the development server.

# 1. Deployed ERC-721 Contract Address (Required)
# The contract address of MyNFT deployed on Ethereum Sepolia Testnet.
# Existing deployment: 0xD4466aBA8C67dD16Af671FAC0aA3B0895A8EdeCf
VITE_CONTRACT_ADDRESS=0xD4466aBA8C67dD16Af671FAC0aA3B0895A8EdeCf

# 2. Pinata IPFS JWT Bearer Token (Required for IPFS uploads)
# Generate a scoped API Key on Pinata (https://app.pinata.cloud/developers/api-keys)
# Required permission: Files -> Write (Admin permissions are NOT required).
# SECURITY NOTE: In client-side Vite apps, all VITE_* variables are embedded in the browser build.
# For educational/demo use only. In production environments, file uploads should be handled via a backend server.
VITE_PINATA_JWT=
